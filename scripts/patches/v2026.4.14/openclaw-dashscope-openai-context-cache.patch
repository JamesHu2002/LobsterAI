@@ -0,0 +1,149 @@
+import type { StreamFn } from "@mariozechner/pi-agent-core";
+import { streamSimple } from "@mariozechner/pi-ai";
+import { streamWithPayloadPatch } from "./stream-payload-utils.js";
+
+const DashScopeContextCacheProvider = {
+  DashScope: "dashscope",
+} as const;
+
+const DashScopeContextCacheMode = {
+  Explicit: "explicit",
+} as const;
+
+const DASHSCOPE_CONTEXT_CACHE_MARKER_LIMIT = 4;
+
+type ChatMessage = {
+  role?: string;
+  content?: unknown;
+};
+
+function hasDashScopeExplicitContextCache(extraParams: Record<string, unknown> | undefined): boolean {
+  return (
+    extraParams?.contextCacheProvider === DashScopeContextCacheProvider.DashScope &&
+    extraParams?.contextCacheMode === DashScopeContextCacheMode.Explicit
+  );
+}
+
+function isTextContentBlock(block: unknown): block is Record<string, unknown> {
+  if (!block || typeof block !== "object") {
+    return false;
+  }
+  const record = block as Record<string, unknown>;
+  return record.type === "text" && typeof record.text === "string";
+}
+
+function countExistingCacheMarkers(messages: ChatMessage[]): number {
+  let count = 0;
+  for (const message of messages) {
+    if (!Array.isArray(message.content)) {
+      continue;
+    }
+    for (const block of message.content) {
+      if (block && typeof block === "object" && "cache_control" in block) {
+        count++;
+      }
+    }
+  }
+  return count;
+}
+
+function markStringContent(message: ChatMessage): boolean {
+  if (typeof message.content !== "string" || !message.content.trim()) {
+    return false;
+  }
+  message.content = [
+    {
+      type: "text",
+      text: message.content,
+      cache_control: { type: "ephemeral" },
+    },
+  ];
+  return true;
+}
+
+function markLastTextBlock(message: ChatMessage): boolean {
+  if (markStringContent(message)) {
+    return true;
+  }
+
+  if (!Array.isArray(message.content)) {
+    return false;
+  }
+
+  for (let idx = message.content.length - 1; idx >= 0; idx--) {
+    const block = message.content[idx];
+    if (!isTextContentBlock(block)) {
+      continue;
+    }
+    if (block.cache_control !== undefined) {
+      return false;
+    }
+    block.cache_control = { type: "ephemeral" };
+    return true;
+  }
+
+  return false;
+}
+
+function markSystemAndDeveloperMessages(messages: ChatMessage[], remainingMarkers: { value: number }): void {
+  for (const message of messages) {
+    if (remainingMarkers.value <= 0) {
+      return;
+    }
+    if (message.role !== "system" && message.role !== "developer") {
+      continue;
+    }
+    if (markLastTextBlock(message)) {
+      remainingMarkers.value--;
+    }
+  }
+}
+
+function markLatestUserMessage(messages: ChatMessage[], remainingMarkers: { value: number }): void {
+  if (remainingMarkers.value <= 0) {
+    return;
+  }
+  for (let idx = messages.length - 1; idx >= 0; idx--) {
+    const message = messages[idx];
+    if (message.role !== "user") {
+      continue;
+    }
+    if (markLastTextBlock(message)) {
+      remainingMarkers.value--;
+    }
+    return;
+  }
+}
+
+export function applyDashScopeExplicitContextCacheMarkers(payloadObj: Record<string, unknown>): void {
+  const messages = payloadObj.messages;
+  if (!Array.isArray(messages)) {
+    return;
+  }
+
+  const chatMessages = messages as ChatMessage[];
+  const remainingMarkers = {
+    value: Math.max(
+      0,
+      DASHSCOPE_CONTEXT_CACHE_MARKER_LIMIT - countExistingCacheMarkers(chatMessages),
+    ),
+  };
+
+  markSystemAndDeveloperMessages(chatMessages, remainingMarkers);
+  markLatestUserMessage(chatMessages, remainingMarkers);
+}
+
+export function createDashScopeOpenAIContextCacheWrapper(
+  baseStreamFn: StreamFn | undefined,
+  extraParams: Record<string, unknown> | undefined,
+): StreamFn {
+  const underlying = baseStreamFn ?? streamSimple;
+  return (model, context, options) => {
+    if (model.api !== "openai-completions" || !hasDashScopeExplicitContextCache(extraParams)) {
+      return underlying(model, context, options);
+    }
+    return streamWithPayloadPatch(underlying, model, context, options, (payloadObj) => {
+      applyDashScopeExplicitContextCacheMarkers(payloadObj);
+    });
+  };
+}
