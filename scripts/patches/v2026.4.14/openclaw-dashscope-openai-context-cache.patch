@@ -0,0 +1,162 @@
+import type { Model } from "@mariozechner/pi-ai";
+import { describe, expect, it } from "vitest";
+import { runExtraParamsCase } from "./extra-params.test-support.js";
+
+type StreamPayload = {
+  messages: Array<{
+    role: string;
+    content: unknown;
+  }>;
+};
+
+const ContextCacheProvider = {
+  DashScope: "dashscope",
+} as const;
+
+const ContextCacheMode = {
+  Explicit: "explicit",
+} as const;
+
+const qwenModel = {
+  api: "openai-completions",
+  provider: "qwen-portal",
+  id: "qwen3.5-plus",
+} as Model<"openai-completions">;
+
+function runDashScopePayload(payload: StreamPayload, withParams = true) {
+  return runExtraParamsCase({
+    cfg: withParams
+      ? {
+          agents: {
+            defaults: {
+              models: {
+                "qwen-portal/qwen3.5-plus": {
+                  params: {
+                    contextCacheProvider: ContextCacheProvider.DashScope,
+                    contextCacheMode: ContextCacheMode.Explicit,
+                  },
+                },
+              },
+            },
+          },
+        }
+      : undefined,
+    model: qwenModel,
+    mockProviderRuntime: true,
+    payload,
+  });
+}
+
+describe("extra-params: DashScope OpenAI explicit context cache", () => {
+  it("injects cache_control into system and latest user text content", () => {
+    const payload = {
+      messages: [
+        { role: "system", content: "system prompt" },
+        { role: "user", content: "hello" },
+      ],
+    };
+
+    runDashScopePayload(payload);
+
+    expect(payload.messages).toEqual([
+      {
+        role: "system",
+        content: [
+          {
+            type: "text",
+            text: "system prompt",
+            cache_control: { type: "ephemeral" },
+          },
+        ],
+      },
+      {
+        role: "user",
+        content: [
+          {
+            type: "text",
+            text: "hello",
+            cache_control: { type: "ephemeral" },
+          },
+        ],
+      },
+    ]);
+  });
+
+  it("leaves payload unchanged when the model params do not opt in", () => {
+    const payload = {
+      messages: [
+        { role: "system", content: "system prompt" },
+        { role: "user", content: "hello" },
+      ],
+    };
+
+    runDashScopePayload(payload, false);
+
+    expect(payload.messages[0].content).toBe("system prompt");
+    expect(payload.messages[1].content).toBe("hello");
+  });
+
+  it("does not inject cache_control for non-chat-completions APIs", () => {
+    const payload = {
+      messages: [
+        { role: "system", content: "system prompt" },
+        { role: "user", content: "hello" },
+      ],
+    };
+
+    runExtraParamsCase({
+      cfg: {
+        agents: {
+          defaults: {
+            models: {
+              "qwen-portal/qwen3.5-plus": {
+                params: {
+                  contextCacheProvider: ContextCacheProvider.DashScope,
+                  contextCacheMode: ContextCacheMode.Explicit,
+                },
+              },
+            },
+          },
+        },
+      },
+      model: {
+        api: "openai-responses",
+        provider: "qwen-portal",
+        id: "qwen3.5-plus",
+      } as Model<"openai-responses">,
+      mockProviderRuntime: true,
+      payload,
+    });
+
+    expect(payload.messages[0].content).toBe("system prompt");
+    expect(payload.messages[1].content).toBe("hello");
+  });
+
+  it("respects the DashScope four-marker request limit", () => {
+    const payload = {
+      messages: [
+        { role: "system", content: "system one" },
+        { role: "developer", content: "developer one" },
+        { role: "developer", content: "developer two" },
+        { role: "developer", content: "developer three" },
+        { role: "user", content: "latest user" },
+      ],
+    };
+
+    runDashScopePayload(payload);
+
+    const markerCount = payload.messages.reduce((count, message) => {
+      if (!Array.isArray(message.content)) {
+        return count;
+      }
+      return count + message.content.filter((block) => (
+        block &&
+        typeof block === "object" &&
+        "cache_control" in block
+      )).length;
+    }, 0);
+
+    expect(markerCount).toBe(4);
+    expect(payload.messages[4].content).toBe("latest user");
+  });
+});
